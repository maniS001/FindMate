generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String?  // Optional for Google Auth users
  name        String
  googleId    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       Item[]
  complaints  Complaint[]
  notifications Notification[]
}

model Item {
  id          String     @id @default(uuid())
  name        String
  category    String
  location    String
  date        String
  description String
  contactInfo String
  imageUris   String[]
  questions   Question[]
  status      String     @default("OPEN") // Added status
  createdAt   DateTime   @default(now())
  
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
}

model Question {
  id       String @id @default(uuid())
  question String
  answer   String
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
}

model Complaint {
  id          String   @id @default(uuid())
  name        String
  category    String
  location    String
  date        String
  description String
  contactInfo String
  imageUris   String
  status      String   @default("OPEN")
  closureReason String? // Added
  reopenReason  String? // Added
  resolvedAt    DateTime? // Added
  createdAt   DateTime @default(now())
  
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
